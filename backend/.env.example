# Copy this file to .env and fill in the values. Never commit .env.
# After changing .env, restart the server. Nodemon doesn't watch this file.

# Server
PORT=5050
# development or production. In production, login cookies require HTTPS.
NODE_ENV=development

# Frontend address, used for CORS and password reset links. No trailing slash.
# Development: http://localhost:5173
# Production: your live site's address
FRONTEND_URL=http://localhost:5173

# MySQL database
HOST=localhost
USER=
PASSWORD=
DATABASE=

# Secrets for signing tokens. Use a different long random value for each:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=
JWT_SECRET=

# Gmail account that sends password reset and budget alert emails.
# EMAIL_PASS must be a Gmail App Password, not the normal account password.
EMAIL_USER=
EMAIL_PASS=
